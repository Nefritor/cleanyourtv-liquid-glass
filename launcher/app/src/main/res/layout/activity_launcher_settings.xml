<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="96dp"
        android:paddingEnd="96dp"
        android:paddingTop="40dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="38sp"
            android:fontFamily="@string/font_light"
            android:letterSpacing="-0.02" />

        <TextView
            android:id="@+id/reorderChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="24dp"
            android:text="@string/reorder"
            android:visibility="gone" />

        <!-- Grid -->
        <TextView style="@style/SettingsSection" android:text="@string/section_grid" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_card"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView style="@style/SettingsLabel" android:layout_width="0dp" android:layout_weight="1" android:paddingStart="8dp" android:text="@string/columns_label" />
                <TextView android:id="@+id/columns4" style="@style/SettingsMiniChoice" android:text="4" />
                <TextView android:id="@+id/columns5" style="@style/SettingsMiniChoice" android:text="5" />
                <TextView android:id="@+id/columns6" style="@style/SettingsMiniChoice" android:text="6" />
                <TextView android:id="@+id/columns7" style="@style/SettingsMiniChoice" android:text="7" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">
                <TextView style="@style/SettingsLabel" android:layout_width="0dp" android:layout_weight="1" android:paddingStart="8dp" android:text="@string/dock_opacity_label" />
                <TextView android:id="@+id/dock100" style="@style/SettingsMiniChoice" android:text="100%" />
                <TextView android:id="@+id/dock70" style="@style/SettingsMiniChoice" android:text="70%" />
                <TextView android:id="@+id/dock50" style="@style/SettingsMiniChoice" android:text="50%" />
                <TextView android:id="@+id/dock30" style="@style/SettingsMiniChoice" android:text="30%" />
            </LinearLayout>

        </LinearLayout>

        <!-- Look -->
        <TextView style="@style/SettingsSection" android:text="@string/section_look" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/appArtChoice"
                style="@style/SettingsRow" />

            <TextView
                android:id="@+id/widgetsChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="8dp"
                android:text="@string/widgets_label" />

            <TextView
                android:id="@+id/wallpaperChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/animationsChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/advancedChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="8dp" />

            <TextView
                style="@style/SettingsHint"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="@string/advanced_effects_warning" />

            <TextView
                android:id="@+id/openOnStartChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- System -->
        <TextView style="@style/SettingsSection" android:text="@string/section_system" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/followThemeChoice"
                style="@style/SettingsRow"
                android:text="@string/follow_theme" />

            <TextView
                style="@style/SettingsHint"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="@string/follow_theme_hint" />

            <TextView
                android:id="@+id/defaultHomeChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="16dp"
                android:text="@string/home_settings" />

            <TextView
                style="@style/SettingsHint"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="@string/home_settings_help" />

            <TextView
                android:id="@+id/tvSettingsChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="16dp"
                android:text="@string/tv_settings" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
